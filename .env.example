# Public URL of the deployed site (used for link previews).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Postgres connection string (Neon, Supabase, Railway, etc).
# Leave unset locally to store RSVPs in ./data/rsvps.json instead.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Password for /admin (at least 8 characters).
ADMIN_PASSWORD=change-me-please
